            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "CONTROL / 03:17.\nThe tanker MERIDIAN\ncarries stolen",
                "guidance chips. Get\naboard. Leave no\nsignal.",
                "A: knife. Hold A to\nuse a terminal. B:\npistol. SELECT:",
                "crouch. START:\npause.",
                "Dark bays conceal\nyou. Dotted marks\nshow guard facing.",
                "Cover blocks sight\nand bullets. Hold A\nnear terminals for",
                "3 seconds. Stay out\nof sight."
              ]
            }
          }
        ]
      }
